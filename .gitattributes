# ------------------------------------------------------------------------------
# LANGUAGE DETECTION
# Force GitHub to recognize this as a PHP project
*.php linguist-language=PHP

# ------------------------------------------------------------------------------
# TEXT FILES — Normalize line endings to LF for cross-platform support
*.php     text eol=lf
*.html    text eol=lf
*.css     text eol=lf
*.js      text eol=lf
*.json    text eol=lf
*.md      text eol=lf
*.env     text eol=lf
*.sh      text eol=lf
*.sql     text eol=lf
*.txt     text eol=lf
.htaccess text eol=lf
*.conf    text eol=lf
*.ini     text eol=lf

# Windows-only scripts
*.bat     text eol=crlf
*.cmd     text eol=crlf

# ------------------------------------------------------------------------------
# BINARY FILES — Prevent Git from altering these
*.png     binary
*.jpg     binary
*.jpeg    binary
*.gif     binary
*.ico     binary
*.webp    binary
*.pdf     binary
*.zip     binary
*.tar     binary
*.gz      binary
*.7z      binary
*.ttf     binary
*.otf     binary
*.woff    binary
*.woff2   binary
*.eot     binary

# ------------------------------------------------------------------------------
# PACKAGE FILES
composer.lock text eol=lf
